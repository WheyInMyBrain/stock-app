# ============================================================================
# FINANCIAL DATA REPOSITORY STORAGE (DO NOT TRACK RAW METRICS OR ASSAYS)
# ============================================================================
# Blocks the entire recursive data tree containing downloaded corporate assets
data/
# Fallback rule in case a loose file drops into a root data marker path
data

# ============================================================================
# GO BUILD ARTIFACTS & BINARIES
# ============================================================================
# Compiled executable binaries generated by go build
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Ignore your compiled scraper tool binary if built locally at root level
downloader/downloader

# ============================================================================
# RUST BUILD ARTIFACTS & WORKSPACE CACHES
# ============================================================================
# Blocks the massive compilation dependency workspace trees recursively
**/target/
target/

# Ignore local Cargo lock files if you intend to preserve binary isolation boundaries
# (Optional: keep tracked if sharing production version locks across teammates)
# cargo.lock

# Temporary crash logs generated by the compiler during panic sequences
cargo-crash.log

# ============================================================================
# C++ & CMAKE BUILD ARTIFACTS
# ============================================================================
# Ignore any layout directory matching standard compilation formats
[Bb]uild/
[Dd]ebug/
[Rr]elease/
ocr/build/

# Ignore intermediate compiler objects and structural binary libraries
*.o
*.a
*.obj
*.lib
*.pdb

# Ignore tracking variables auto-generated by CMake config loops
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
_deps/
CMakeUserPresets.json
*.txt.user

# ============================================================================
# PYTHON & VIRTUAL ENVIRONMENT ARTIFACTS
# ============================================================================
# Ignore local virtual environment cages (including your new localized ocr workspace)
.venv/
venv/
ENV/
env/

# Ignore byte-compiled/optimized execution runtime targets
__pycache__/
*.py[cod]
*$py.class

# Ignore diagnostic distributions, package manifests, and wheel setups
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Ignore testing caches and structural workspace layout tracks
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ignore downstream multi-modal layout weights downloaded locally via Docling
.models/

# ============================================================================
# MACHINE LEARNING BINARY ENGINE WEIGHTS (CRITICAL)
# ============================================================================
# Blocks massive neural network model files from accidentally syncing to Git
*.gguf
*.onnx
ocr/models/

# ============================================================================
# OPERATING SYSTEM & ENVIRONMENT CONFIGURATION FILES
# ============================================================================
# Local environment variables containing credentials/API private paths
.env
.env.local

# macOS system overhead files
.DS_Store
.AppleDouble
.LSOverride

# Windows folder thumbnail and configuration caches
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# ============================================================================
# INTEGRATED DEVELOPMENT ENVIRONMENT SETTINGS (VS Code / GoLand / Cursor)
# ============================================================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp